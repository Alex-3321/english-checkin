# ============================================
# 英语打卡系统 · 环境变量模板
# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进入仓库
# ============================================

# 服务监听
PORT=3000
HOST=127.0.0.1

# 会话签名密钥（留空则首次启动自动生成到 .secret 文件）
# 生产环境建议显式设置一个 32 字节以上的随机串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# 业务日刷新时间（小时，0-23）。默认 7，即每天 07:00 进入新的一天。
RESET_HOUR=7

# 站点标题（首页顶部与顶栏）。首次启动写入数据库，之后以后台设置为准。
SITE_TITLE=朗英 英语协会

# 超级管理员（首次启动且库中无 super_admin 时自动创建）
SUPER_ADMIN_ID=3321
SUPER_ADMIN_PASSWORD=change-me-please

# ============================================
# AI 阅卷（视觉大模型）
# 不填 AI_API_KEY 时自动进入 mock 模式：按图片 md5 分配 A/B/C/INVALID，便于本地联调
# ============================================
# mock | zhipu | qwen
AI_PROVIDER=mock

# 智谱开放平台 Key（https://open.bigmodel.cn → API Keys）
# 填了它并把 AI_PROVIDER 设为 zhipu，就会调用真实模型；留空则始终 mock
ZHIPU_API_KEY=

# 可选：默认 glm-4.6v-flash / qwen-vl-plus
AI_MODEL=
# 可选：自定义网关
AI_BASE_URL=
# 超时毫秒（默认 10000），超时自动降级为 B 级
AI_TIMEOUT_MS=10000
