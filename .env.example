# ============================================
# 英语打卡系统 · 环境变量模板
# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进入仓库
# ============================================

# 服务监听
PORT=3000
HOST=127.0.0.1

# 会话签名密钥（留空则首次启动自动生成到 .secret 文件）
# 生产环境建议显式设置一个 32 字节以上的随机串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# 超级管理员（首次启动且库中无 super_admin 时自动创建）
SUPER_ADMIN_ID=3321
SUPER_ADMIN_PASSWORD=change-me-please
