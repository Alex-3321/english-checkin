[Unit]
Description=English Check-in Web (Node.js + SQLite)
After=network.target
Wants=network.target

[Service]
Type=simple
User=english
Group=english
WorkingDirectory=/opt/english-checkin
EnvironmentFile=-/opt/english-checkin/.env
ExecStart=/usr/bin/env node /opt/english-checkin/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/english-checkin
StandardOutput=journal
StandardError=journal
SyslogIdentifier=english-checkin

[Install]
WantedBy=multi-user.target
